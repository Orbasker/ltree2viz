#!/usr/bin/env node
"use strict";

// Resolves the ltree2viz binary from the platform package that npm installed
// (exactly one of the @ltree2viz/* optionalDependencies matches this host) and
// execs it. stdio is inherited so the diagram stays on stdout and diagnostics
// on stderr — `npx ltree2viz - | pbcopy` must pipe a clean diagram.

const { spawnSync } = require("child_process");

function resolveBinary() {
  const pkg = `@ltree2viz/${process.platform}-${process.arch}`;
  const exe = process.platform === "win32" ? "ltree2viz.exe" : "ltree2viz";
  try {
    return require.resolve(`${pkg}/${exe}`);
  } catch {
    throw new Error(
      `ltree2viz: no prebuilt binary for ${process.platform}-${process.arch}.\n` +
        `Expected the optional dependency ${pkg} to be installed. Supported ` +
        `platforms: darwin-arm64, darwin-x64, linux-x64, linux-arm64, win32-x64.\n` +
        `If you installed with --no-optional, reinstall without it. Otherwise ` +
        `build from source: https://github.com/Orbasker/ltree2viz`,
    );
  }
}

let binary;
try {
  binary = resolveBinary();
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exit(1);
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });

if (result.error) {
  process.stderr.write(`ltree2viz: failed to run binary: ${result.error.message}\n`);
  process.exit(1);
}

// spawnSync sets `signal` (and null status) when the child is killed by one.
if (result.signal) {
  process.kill(process.pid, result.signal);
}

process.exit(result.status === null ? 1 : result.status);
